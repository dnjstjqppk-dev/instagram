{
  "$schema": "https://json.schemastore.org/design-tokens.json",
  "name": "Aura Design System Tokens",
  "version": "1.0.0",
  "brand": {
    "name": "Aura",
    "tagline": "Connect, Create, Transcend",
    "gradient": {
      "primary": "linear-gradient(45deg, #FF007A 0%, #7928CA 50%, #0070F3 100%)",
      "accent": "linear-gradient(135deg, #FF4D4D 0%, #F9CB28 100%)",
      "story_unseen": "linear-gradient(45deg, #F58529, #DD2A7B, #8134AF, #515BD4)",
      "story_seen": "linear-gradient(45deg, #8E8E8E, #B2B2B2)",
      "story_close_friends": "linear-gradient(45deg, #10B981, #059669)"
    }
  },
  "colors": {
    "light": {
      "background": "#FFFFFF",
      "surface": "#FAFAFA",
      "surface_elevated": "#FFFFFF",
      "border": "#DBDBDB",
      "border_subtle": "#EFEFEF",
      "text_primary": "#121212",
      "text_secondary": "#737373",
      "text_tertiary": "#8E8E8E",
      "accent_primary": "#0095F6",
      "accent_primary_hover": "#1877F2",
      "accent_danger": "#ED4956",
      "accent_success": "#10B981",
      "accent_warning": "#F59E0B",
      "overlay": "rgba(0, 0, 0, 0.65)"
    },
    "dark": {
      "background": "#000000",
      "surface": "#121212",
      "surface_elevated": "#262626",
      "border": "#262626",
      "border_subtle": "#363636",
      "text_primary": "#F5F5F5",
      "text_secondary": "#A8A8A8",
      "text_tertiary": "#737373",
      "accent_primary": "#0095F6",
      "accent_primary_hover": "#3897F0",
      "accent_danger": "#ED4956",
      "accent_success": "#10B981",
      "accent_warning": "#F59E0B",
      "overlay": "rgba(0, 0, 0, 0.85)"
    }
  },
  "typography": {
    "fontFamily": {
      "sans": "-apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, Helvetica, Arial, sans-serif",
      "mono": "ui-monospace, SFMono-Regular, Menlo, Monaco, Consolas, monospace"
    },
    "fontSize": {
      "xs": "11px",
      "sm": "12px",
      "base": "14px",
      "md": "16px",
      "lg": "18px",
      "xl": "20px",
      "2xl": "24px",
      "3xl": "28px"
    },
    "fontWeight": {
      "regular": 400,
      "medium": 500,
      "semibold": 600,
      "bold": 700
    },
    "lineHeight": {
      "tight": 1.2,
      "normal": 1.4,
      "relaxed": 1.6
    }
  },
  "spacing": {
    "0": "0px",
    "1": "4px",
    "2": "8px",
    "3": "12px",
    "4": "16px",
    "5": "20px",
    "6": "24px",
    "8": "32px",
    "10": "40px",
    "12": "48px",
    "16": "64px"
  },
  "radii": {
    "none": "0px",
    "sm": "4px",
    "md": "8px",
    "lg": "12px",
    "xl": "16px",
    "full": "9999px"
  },
  "shadows": {
    "sm": "0 1px 2px rgba(0, 0, 0, 0.05)",
    "md": "0 4px 6px -1px rgba(0, 0, 0, 0.1), 0 2px 4px -1px rgba(0, 0, 0, 0.06)",
    "lg": "0 10px 15px -3px rgba(0, 0, 0, 0.1), 0 4px 6px -2px rgba(0, 0, 0, 0.05)",
    "elevated": "0 12px 28px 0 rgba(0, 0, 0, 0.2), 0 2px 4px 0 rgba(0, 0, 0, 0.1)"
  },
  "motion": {
    "duration": {
      "instant": "100ms",
      "fast": "200ms",
      "normal": "300ms",
      "slow": "500ms"
    },
    "easing": {
      "easeInOut": "cubic-bezier(0.4, 0, 0.2, 1)",
      "easeOut": "cubic-bezier(0.0, 0, 0.2, 1)",
      "spring": "cubic-bezier(0.175, 0.885, 0.32, 1.275)"
    }
  },
  "breakpoints": {
    "mobile": "320px",
    "tablet": "768px",
    "desktop": "1024px",
    "wide": "1280px",
    "ultrawide": "1440px"
  }
}
